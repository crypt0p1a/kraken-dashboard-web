# Copy to .env (ignored by git)

# The key the bot signs its pushes with: its KRAKEN_BOT_PUSH_KEY, the same. 32 characters at least,
# made once with: openssl rand -hex 32
KRAKEN_DASHBOARD_WEB_PUSH_KEY=

# The password of the dashboard, hashed: never the password itself. Made once with
#   docker compose run --rm -it kraken-dashboard-web hash-password
# which asks for it twice and gives the whole line, quoted (a $ in it read as is)
KRAKEN_DASHBOARD_WEB_PASSWORD_HASH=

# plain HTTP only, a test on this machine: the cookie of the session sent back without HTTPS
# KRAKEN_DASHBOARD_WEB_COOKIE_SECURE=false
